<launch>
    <!--
      Bancada de teste do estabilizador de atitude (Fase 2).

      Sobe o Gazebo com a Marta em pe, PARADA (walk_enabled=false), com o
      estimador de atitude e o controlador. Nao inclui visao, levantar nem
      diagnosticos: so o que participa da malha de equilibrio.

      O Gazebo sobe PAUSADO de proposito (ver comentario abaixo). Quem despausa
      e o push_test.py; pela interface grafica, o botao play tambem serve.

      Uso:
        # terminal 1 - com janela do Gazebo
        roslaunch marta_bringup stabilizer_test.launch
        # ou sem janela (mais rapido)
        roslaunch marta_bringup stabilizer_test.launch gui:=false

        # terminal 2 - despausa, espera assentar, empurra e mede
        rosrun marta_bringup push_test.py
        rosrun marta_bringup push_test.py _force:=8 _duration:=0.15
        rosrun marta_bringup push_test.py _force:=-5     # empurrao por tras

      Para comparar com e sem estabilizador, o mais confiavel e subir a
      simulacao duas vezes (o robo nao volta a uma condicao limpa depois de
      cair):
        roslaunch marta_bringup stabilizer_test.launch gui:=false stabilizer_enabled:=false
        roslaunch marta_bringup stabilizer_test.launch gui:=false stabilizer_enabled:=true

      Sintonia com o robo em pe, sem reiniciar nada:
        rosparam set /controller_node/kp_pitch 0.35
        rosparam set /controller_node/kd_pitch 0.05
        rosparam set /controller_node/stabilizer_enabled false
    -->

    <arg name="gui" default="true"/>
    <!--
      Mesmo mundo do bringup: o campo. Nao e so cenario - world.world traz
      ajustes proprios de contato (contact_max_correcting_vel = 0,
      contact_surface_layer = 1e-4) que mudam como o pe toca o chao, entao
      medir aqui e medir no ambiente real de uso.
      Para uma rodada mais leve: world_name:=worlds/empty.world
    -->
    <arg name="world_name" default="world.world"/>

    <!-- Ganhos do estabilizador, sobrescreviveis na linha de comando -->
    <arg name="kp_pitch" default="0.2"/>
    <arg name="kd_pitch" default="0.03"/>
    <arg name="max_pitch_correction" default="0.1745"/>
    <arg name="stabilizer_enabled" default="true"/>
    <!-- 1.0 = como o gerador sempre esteve; 0.734 casa o tZMP com a altura
         real do CoM medida pela telemetria (0.218 m em vez de 0.2975 m). -->
    <arg name="com_swing_factor" default="1.0"/>
    <!-- Parametros do gerador. Defaults = os do gerador (OmnidirectionalWalkZMP.cpp),
         valores de out/2026 (docs/ajustes_marcha.md); z_com e a altura do
         tronco na IK (subir estica a perna). -->
    <arg name="z_com" default="0.252"/>
    <arg name="z_step" default="0.08"/>
    <arg name="step_period" default="0.6"/>
    <arg name="double_support_ratio" default="0.3"/>
    <arg name="y_separation" default="0.06"/>
    <!-- Somado ao hip pitch depois da IK [graus]; -5 inclina o tronco ~5 graus para
         a frente quando os servos nao cedem (panorama_parametros.md). -->
    <arg name="hip_pitch_offset_deg" default="-5.0"/>
    <arg name="use_link_states" default="true"/>
    <arg name="telemetry" default="true"/>

    <!--
      walk_enabled=false: robo em pe (teste de perturbacao da Fase 2).
      O walk_test.py liga a marcha em tempo de execucao depois que o robo
      assenta, entao normalmente nao e preciso mexer aqui.
    -->
    <arg name="walk_enabled" default="false"/>
    <arg name="walk_velocity_x" default="0.1"/>
    <arg name="walk_velocity_y" default="0.0"/>
    <arg name="walk_velocity_yaw" default="0.0"/>
    <!-- Pe que balanca no primeiro passo; true espelha a partida (teste do
         espelho do desvio de direcao). -->
    <arg name="start_left_swing" default="false"/>
    <!-- Partida suave em N passos (0 = desligada, comportamento historico). -->
    <arg name="start_ramp_steps" default="0"/>
    <!-- Malha de rumo (yaw), LIGADA por default nesta launch de simulacao
         (kp=1, sat=0,3: ver docs/desvio_de_direcao.md §8). kp em rad/s por rad de
         erro; a correcao satura em max_heading_rate. -->
    <arg name="heading_enabled" default="true"/>
    <!-- Visualizacao: foxglove_bridge ao vivo e taxa da TF das juntas. -->
    <arg name="foxglove" default="false"/>
    <arg name="tf_rate" default="50.0"/>
    <!-- Pula os passos de ajuste depois do Agacha() (para direto). -->
    <arg name="skip_initial_stop_steps" default="false"/>
    <arg name="kp_heading" default="1.0"/>
    <arg name="max_heading_rate" default="0.3"/>

    <!-- Knobs de realismo. Defaults = modelo original, nada muda sem ser pedido.
         Ver o cabeçalho de marta.xacro para o significado de cada um. -->
    <arg name="foot_mu"         default="1e10"/>
    <arg name="joint_effort"    default="1000.0"/>
    <arg name="joint_damping"   default="0.0"/>
    <arg name="joint_friction"  default="0.0"/>
    <arg name="contact_kp"      default="1000000.0"/>
    <arg name="contact_kd"      default="10000.0"/>
    <arg name="imu_gyro_noise"  default="0.0"/>
    <arg name="imu_accel_noise" default="0.0"/>
    <arg name="imu_gyro_bias"   default="0.0"/>
    <arg name="foot_collision"  default="box"/>
    <!-- Escala da massa do tronco (1.0 = modelo original); ver marta.xacro. -->
    <arg name="torso_mass_scale" default="1.0"/>
    <!-- Modelo de servo: amortecimento implicito (com joint_damping) e ganhos
         alternativos carregados por cima do controller.yaml. -->
    <arg name="implicit_damping" default="false"/>
    <arg name="joint_velocity" default="0.01"/>
    <!-- Compensacao de gravidade (feedforward tau/Kp nas pernas;
         LegGravityCompensation.h). Default desligada. -->
    <arg name="gravity_comp_enabled" default="false"/>
    <arg name="gravity_comp_joints" default="hip_roll,knee"/>
    <arg name="gravity_comp_gain" default="1.0"/>
    <arg name="max_gravity_comp" default="0.35"/>
    <arg name="gravity_comp_swing" default="false"/>
    <!-- x do quadril em relacao ao tronco na IK [m]; default = o do codigo
         (RobotPhysicalParameters.cpp). URDF: 0,0036. -->
    <arg name="hip_offset_x" default="0.013349"/>
    <arg name="gains" default=""/>

    <param name="robot_description"
           command="$(find xacro)/xacro '$(find marta_description)/urdf/marta.xacro'
                    foot_mu:=$(arg foot_mu)
                    joint_effort:=$(arg joint_effort)
                    torso_mass_scale:=$(arg torso_mass_scale)
                    implicit_damping:=$(arg implicit_damping)
                    joint_velocity:=$(arg joint_velocity)
                    joint_damping:=$(arg joint_damping)
                    joint_friction:=$(arg joint_friction)
                    contact_kp:=$(arg contact_kp)
                    contact_kd:=$(arg contact_kd)
                    imu_gyro_noise:=$(arg imu_gyro_noise)
                    imu_accel_noise:=$(arg imu_accel_noise)
                    imu_gyro_bias:=$(arg imu_gyro_bias)
                    foot_collision:=$(arg foot_collision)"/>

    <!--
      Gazebo sobe PAUSADO, como no bringup.launch. Isso e essencial: o
      controller_spawner leva alguns segundos, e sem comando de junta o robo
      desaba antes de qualquer controle assumir. Quem despausa e o push_test.py,
      depois que os controladores estao no ar.
    -->
    <include file="$(find marta_gazebo)/launch/gazebo_init.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="true"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="$(arg gui)"/>
    </include>

    <!-- Pernas retas, como no gazebo.launch: e a postura que o Agacha() do
         controller_node usa como ponto de partida da rampa (escala 0 -> 1). -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
          args="-param robot_description -urdf -model marta -x 0 -y 0 -z 0.3609"/>

    <include file="$(find marta_gazebo)/launch/controller.launch"/>
    <rosparam if="$(eval gains != '')" file="$(arg gains)" command="load"/>

    <node name="robot_state_publisher" pkg="robot_state_publisher"
          type="robot_state_publisher" output="log">
        <remap from="/joint_states" to="/marta/joint_states"/>
        <param name="publish_frequency" value="$(arg tf_rate)"/>
    </node>

    <!-- Foxglove ao vivo: o app no host conecta em ws://localhost:8765 (o
         container roda com network host). Desligado por default: o bridge
         serializa os topicos assinados e pode baixar o RTF das campanhas. -->
    <include if="$(arg foxglove)"
             file="$(find foxglove_bridge)/launch/foxglove_bridge.launch">
        <arg name="port" value="8765"/>
    </include>

    <!-- Estimacao de atitude (Fase 1) -->
    <node pkg="marta_controller" type="torso_attitude_node" name="torso_attitude_node"
          output="screen">
        <param name="imu_topic" value="/marta/imu"/>
        <param name="attitude_topic" value="/marta/torso_attitude"/>
        <param name="expected_rate_hz" value="100.0"/>
        <param name="alpha" value="0.998"/>
        <param name="gyro_cutoff_hz" value="15.0"/>
        <param name="accel_trust_band" value="2.0"/>
        <rosparam param="imu_mount_rpy">[0.0, 3.14159265358979, 0.0]</rosparam>
    </node>

    <!-- Telemetria de marcha: funde o plano do gerador com a verdade de solo
         do Gazebo e publica as grandezas do 3D-LIPM (Kajita 2001). -->
    <node pkg="marta_controller" type="walk_telemetry_node" name="walk_telemetry_node"
          output="screen" if="$(arg telemetry)">
        <param name="rate_hz" value="100.0"/>
        <param name="model_name" value="marta"/>
        <param name="use_link_states" value="$(arg use_link_states)"/>
    </node>

    <!-- Controlador com a marcha desligada: so o estabilizador atua -->
    <node pkg="marta_controller" type="controller_node" name="controller_node"
          output="screen">
        <param name="isReal" value="false"/>
        <!-- As hip_yaw do URDF tem eixo -z: sem isso, rotacao comandada para a
             esquerda vira giro para a direita. Ver InverseKinematics.h. -->
        <param name="hip_yaw_sign" value="-1.0"/>
        <param name="walk_enabled" value="$(arg walk_enabled)"/>
        <param name="walk_velocity_x" value="$(arg walk_velocity_x)"/>
        <param name="walk_velocity_y" value="$(arg walk_velocity_y)"/>
        <param name="walk_velocity_yaw" value="$(arg walk_velocity_yaw)"/>
        <param name="start_left_swing" value="$(arg start_left_swing)"/>
        <param name="start_ramp_steps" value="$(arg start_ramp_steps)"/>
        <param name="heading_enabled" value="$(arg heading_enabled)"/>
        <param name="skip_initial_stop_steps" value="$(arg skip_initial_stop_steps)"/>
        <param name="kp_heading" value="$(arg kp_heading)"/>
        <param name="max_heading_rate" value="$(arg max_heading_rate)"/>
        <param name="use_xscale_service" value="false"/>
        <!-- Sem recuperacao de queda: aqui se mede a resposta do estabilizador,
             e o levantar so atrapalharia a medicao. -->
        <param name="fall_recovery_enabled" value="false"/>
        <param name="stabilizer_enabled" value="$(arg stabilizer_enabled)"/>
        <param name="com_swing_factor" value="$(arg com_swing_factor)"/>
        <param name="gravity_comp_enabled" value="$(arg gravity_comp_enabled)"/>
        <param name="gravity_comp_joints" value="$(arg gravity_comp_joints)"/>
        <param name="gravity_comp_gain" value="$(arg gravity_comp_gain)"/>
        <param name="max_gravity_comp" value="$(arg max_gravity_comp)"/>
        <param name="gravity_comp_swing" value="$(arg gravity_comp_swing)"/>
        <param name="hip_offset_x" value="$(arg hip_offset_x)"/>
        <param name="z_com" value="$(arg z_com)"/>
        <param name="z_step" value="$(arg z_step)"/>
        <param name="step_period" value="$(arg step_period)"/>
        <param name="double_support_ratio" value="$(arg double_support_ratio)"/>
        <param name="y_separation" value="$(arg y_separation)"/>
        <param name="hip_pitch_offset_deg" value="$(arg hip_pitch_offset_deg)"/>
        <param name="kp_pitch" value="$(arg kp_pitch)"/>
        <param name="kd_pitch" value="$(arg kd_pitch)"/>
        <param name="max_pitch_correction" value="$(arg max_pitch_correction)"/>
    </node>
</launch>
